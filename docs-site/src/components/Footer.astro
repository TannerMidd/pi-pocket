---
// Starlight's footer, and which version of Pi Pocket the pages describe.
import Default from "@astrojs/starlight/components/Footer.astro";
---

<Default><slot /></Default>
<p class="version">
    These pages describe Pi Pocket {__POCKET_VERSION__}. Your copy has the pages of its own version in its{" "}
    <code>docs/</code> folder.
</p>

<style>
    .version {
        margin-top: 1.5rem;
        font-size: var(--sl-text-xs);
        color: var(--sl-color-gray-3);
    }
</style>
