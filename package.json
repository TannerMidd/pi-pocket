{
    "name": "pi-pocket",
    "version": "0.12.2",
    "description": "A durable, multiplayer, mobile-first web app for Pi agents, built on Pi Durable",
    "private": true,
    "type": "module",
    "license": "MIT",
    "author": "Tanner Middleton",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TannerMidd/pi-pocket.git"
    },
    "homepage": "https://tannermidd.github.io/pi-pocket/",
    "bugs": {
        "url": "https://github.com/TannerMidd/pi-pocket/issues"
    },
    "bin": {
        "pi-pocket": "bin/pi-pocket.js"
    },
    "engines": {
        "node": ">=22.19"
    },
    "scripts": {
        "start": "node bin/pi-pocket.js",
        "dev": "node bin/pi-pocket.js --cwd .",
        "check": "tsc --noEmit -p .",
        "test": "node --test test/*.test.ts",
        "site:publish": "git subtree push --prefix site origin gh-pages",
        "format": "eslint --fix . && prettier --write .",
        "format:check": "prettier --check . && eslint .",
        "lint": "eslint ."
    },
    "dependencies": {
        "@earendil-works/chord": "1.1.0",
        "@earendil-works/pi-ai": "1.1.0",
        "@earendil-works/pi-codemode": "1.1.0",
        "@earendil-works/pi-coding-agent": "1.1.0",
        "@earendil-works/pi-durable": "1.1.0",
        "dompurify": "^3.4.16",
        "htm": "^3.1.1",
        "jiti": "2.7.0",
        "marked": "^18.1.0",
        "preact": "^11.0.1",
        "qrcode": "^1.5.4",
        "undici": "8.11.2"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1"
    }
}
