{
  "name": "pi-pocket",
  "version": "0.1.0",
  "description": "A durable, multiplayer, mobile-first web app for Pi agents, built on Pi Durable",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "pi-pocket": "bin/pi-pocket.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node bin/pi-pocket.js",
    "dev": "node bin/pi-pocket.js --cwd .",
    "check": "tsc --noEmit -p .",
    "test": "node --test test/*.test.ts",
    "site:publish": "git subtree push --prefix site origin gh-pages"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-durable": "1.0.1",
    "dompurify": "^3.4.16",
    "htm": "^3.1.1",
    "marked": "^18.0.14",
    "preact": "^11.0.0",
    "qrcode": "^1.5.4",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  }
}
