{
    "name": "pi-pocket",
    "version": "0.27.0",
    "description": "A durable, multiplayer, mobile-first web app for Pi agents, built on Pi Durable",
    "keywords": [
        "pi",
        "ai",
        "agent",
        "coding-agent",
        "mobile",
        "multiplayer",
        "durable"
    ],
    "type": "module",
    "license": "MIT",
    "author": "Tanner Middleton",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TannerMidd/pi-pocket.git"
    },
    "homepage": "https://tannermidd.github.io/pi-pocket/",
    "bugs": {
        "url": "https://github.com/TannerMidd/pi-pocket/issues"
    },
    "bin": {
        "pi-pocket": "bin/pi-pocket.js"
    },
    "files": [
        "bin/",
        "src/",
        "web/",
        "types/",
        "docs/",
        "contrib/",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "npm-shrinkwrap.json"
    ],
    "engines": {
        "node": ">=22.19"
    },
    "scripts": {
        "start": "node bin/pi-pocket.js",
        "dev": "node bin/pi-pocket.js --cwd .",
        "check": "tsc --noEmit -p . && node test/types-file.ts && node docs-site/check-reference.mjs",
        "test": "node --test --test-concurrency=4 test/*.test.ts",
        "site:publish": "gh workflow run pages.yml",
        "format": "eslint --fix . && prettier --write .",
        "format:check": "prettier --check . && eslint .",
        "lint": "eslint .",
        "prepack": "node -e \"require('node:fs').copyFileSync('package-lock.json', 'npm-shrinkwrap.json')\"",
        "postpack": "node -e \"require('node:fs').rmSync('npm-shrinkwrap.json', { force: true })\"",
        "prepublishOnly": "npm run check && npm run lint && npm test"
    },
    "dependencies": {
        "@earendil-works/chord": "1.4.0",
        "@earendil-works/pi-ai": "1.4.0",
        "@earendil-works/pi-codemode": "1.4.0",
        "@earendil-works/pi-coding-agent": "1.4.0",
        "@earendil-works/pi-durable": "1.4.0",
        "@earendil-works/pi-mcp": "1.4.0",
        "dompurify": "^3.4.17",
        "htm": "^3.1.1",
        "jiti": "2.7.0",
        "marked": "^18.1.1",
        "preact": "^11.0.2",
        "qrcode": "^1.5.4",
        "undici": "8.12.3"
    },
    "overrides": {
        "undici": "8.12.3"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1"
    }
}
