#!/bin/bash
# Runs before the payload goes in, as the user (the package installs in the home folder only): it stops a running
# Pi Pocket of this install, and removes the old Node.js, so that no file of an older one stays in the new one.
# $2 is the install folder, ~/Library/Application Support/Pi Pocket.
set -u
APP="$2"

if [ "$(id -u)" = 0 ] || [ "$APP" != "$HOME/Library/Application Support/Pi Pocket" ]; then
    echo "Pi Pocket installs for the current user only: install it for yourself, without sudo, not in $APP."
    exit 1
fi

# The folder must be empty or an earlier install: the deletes below must not hit files that are not Pi Pocket's.
if [ -d "$APP" ] && [ ! -f "$APP/pi-pocket" ] && [ -n "$(ls -A "$APP")" ]; then
    echo "$APP is not empty and holds no Pi Pocket install."
    exit 1
fi

# shellcheck source=packaging/macos/stop-pi-pocket.sh
. "$(dirname "$0")/stop-pi-pocket.sh"

if ! stop_pi_pocket; then
    echo "Pi Pocket still runs: quit it (press q in its window), then install again."
    exit 1
fi

rm -rf "$APP/node" "$APP/Pi Pocket.app"
