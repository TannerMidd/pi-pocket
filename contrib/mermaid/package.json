{
    "name": "pi-pocket-mermaid-drop-in",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "esbuild vendor-entry.js --bundle --minify --format=esm --legal-comments=linked --outfile=mermaid/vendor.js",
        "check": "tsc --noEmit -p . && node --check mermaid/index.js && node --check vendor-entry.js && node --check mermaid.ts",
        "test": "node --test tests/*.test.ts"
    },
    "dependencies": {
        "dompurify": "3.4.17",
        "mermaid": "12.2.0"
    },
    "devDependencies": {
        "esbuild": "0.28.2"
    }
}
